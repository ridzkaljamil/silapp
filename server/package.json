{
  "name": "silapp-server",
  "version": "1.0.0",
  "private": true,
  "description": "REST API SILAPP - Sistem Informasi Layanan dan Tracking Pengujian Produk PT Penilai Standar Uji",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:reset": "node database/seed.js",
    "db:reset:demo": "node database/seed.js .env.demo",
    "db:init": "node database/seed.js --bersih",
    "db:sql": "node database/build-init-sql.js",
    "jobs": "node src/jobs/run.js",
    "test": "node tests/run.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.3",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.15.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
