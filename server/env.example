# =========================================================
# SILAPP - contoh pengaturan server
# Salin file ini menjadi ".env" (di folder server), lalu isi nilainya.
#   - Komputer (XAMPP)  : cukup isi bagian SERVER dan DATABASE.
#   - cPanel            : isi semua bagian kecuali VERCEL (lihat DEPLOY-CPANEL.md).
#   - Vercel            : isi lewat Settings > Environment Variables, bukan file ini (lihat DEPLOY-VERCEL.md).
# File .env berisi rahasia: jangan dibagikan dan jangan ikut di-upload ke GitHub.
# Nilai yang mengandung tanda # atau spasi WAJIB diapit tanda kutip ganda, contoh: DB_PASS="Ab#12 cd".
#   Tanpa kutip, semua teks setelah # dianggap komentar sehingga kata sandi terbaca terpotong.
# =========================================================

# ---------- SERVER ----------
PORT=5000
# Alamat aplikasi, tanpa garis miring di akhir. Dipakai untuk tautan di email (mis. reset kata sandi).
# Komputer: http://localhost:5173  ·  cPanel: https://silapp.penilaistandaruji.com
CLIENT_URL=http://localhost:5173
# Teks acak panjang (minimal 32 karakter). Server resmi wajib memakai nilai BARU.
# Mengganti nilai ini membuat semua orang keluar (logout).
JWT_SECRET=ganti-dengan-teks-acak-panjang
JWT_EXPIRES=1d
# Isi 1 bila aplikasi berjalan di belakang web server / reverse proxy (cPanel, Nginx).
TRUST_PROXY=

# ---------- DATABASE (MySQL / MariaDB) ----------
# cPanel: nama database & user diawali nama akun cPanel, mis. akuncpanel_silapp.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=silapp
DB_USER=root
DB_PASS=
# Hanya untuk database di server lain (mis. Vercel -> MySQL VPS):
#   DB_SSL=true, DB_SSL_STRICT=false (sertifikat self-signed), DB_POOL_LIMIT=3
DB_SSL=
DB_SSL_STRICT=
DB_POOL_LIMIT=
# Zona waktu sesi database. Biarkan kosong (bawaan +07:00 / WIB).
DB_TIMEZONE=
# Database khusus pengujian otomatis (npm test). Kosong = <DB_NAME>_test.
TEST_DB_NAME=

# ---------- EMAIL (SMTP) ----------
# Kosongkan SMTP_HOST agar email tidak dikirim (isinya hanya dicetak di console & dicatat di Log Email).
# cPanel: buat akun di "Email Accounts", mis. no-reply@penilaistandaruji.com; host biasanya mail.<domain>.
# Port 465 + SMTP_SECURE=true (SSL), atau port 587 + SMTP_SECURE=false bila 465 diblokir.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SILAPP PT Penilai Standar Uji <no-reply@penilaistandaruji.com>"

# ---------- AKUN SUPER ADMIN PERTAMA (server baru) ----------
# Dipakai sekali saat database belum punya Super Admin (database dari silapp-init.sql).
# Setelah berhasil masuk, KOSONGKAN SUPERADMIN_PASSWORD lalu restart aplikasi.
SUPERADMIN_NAME=Super Admin PSU
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ---------- TUGAS TERJADWAL ----------
# Pengingat (sertifikat akan berakhir, invoice jatuh tempo, batas temuan) dan kirim ulang email gagal.
# Selama aplikasi menyala, tugas berjalan otomatis setiap JOBS_INTERVAL_MIN menit (bawaan 30; 0 = mati).
# Di cPanel tetap disarankan memasang Cron Jobs harian (npm run jobs), lihat DEPLOY-CPANEL.md.
JOBS_INTERVAL_MIN=
# Rahasia untuk alamat /api/cron (Vercel Cron atau layanan cron dari luar). Kosong = alamat itu dimatikan.
CRON_SECRET=

# ---------- VERCEL ----------
# Token Vercel Blob (penyimpanan file). Terisi otomatis saat Blob store dihubungkan ke project Vercel.
# Di komputer/cPanel biarkan kosong: file disimpan di folder server/uploads.
BLOB_READ_WRITE_TOKEN=
